        <mxCell id="guest" value="Guest mobile web / PWA&#xa;Reservation access, room selection, check-in, concierge, requests, checkout" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#153B32;fillColor=#153B32;fontColor=#FFFDF8;fontStyle=1;" vertex="1" parent="channels"><mxGeometry x="30" y="48" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="ops" value="Hotel operations mobile / desktop&#xa;Property login, queue, SLA, feedback, reports, AI analyst" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#153B32;fillColor=#153B32;fontColor=#FFFDF8;fontStyle=1;" vertex="1" parent="channels"><mxGeometry x="405" y="48" width="335" height="70" as="geometry"/></mxCell>
