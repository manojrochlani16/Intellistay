        <mxCell id="title" value="INTELLISTAY  |  PROACTIVE AI CONCIERGE  |  TECHNICAL ARCHITECTURE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=24;fontColor=#153B32;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1180" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Guest and hotel experiences share controlled workflows, not shared user access. Solid green nodes are functional in the demo. Dashed nodes are production integrations." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6F7772;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1200" height="30" as="geometry"/></mxCell>

