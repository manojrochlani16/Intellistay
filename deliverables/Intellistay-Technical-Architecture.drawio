        <mxCell id="trust" value="IDENTITY, TENANCY AND TRUST" style="swimlane;html=1;startSize=28;horizontal=1;rounded=1;strokeColor=#7F9B8C;fillColor=#F5F0E6;fontColor=#153B32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="1220" height="150" as="geometry"/></mxCell>
